# Gate-status markers written by merge-guard.sh at runtime
.gate-status/
.orchestration/.gate-status/

# Caller-owned run-context mirrors written by ticket-branch.sh
.orchestration/runs/

# Visual-QA capture artifacts
.orchestration/screens/

# OS / editor cruft
.DS_Store
*.swp

# Local env / secrets (never committed; the scripts read these from the env)
.env
.env.local
